<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutogestionSena.MAUI.Views.CodeVerificationPage"
             BackgroundColor="White">
    <ScrollView>
        <VerticalStackLayout Padding="30,40" Spacing="30" HorizontalOptions="Center" WidthRequest="400">
            <!-- Volver -->
            <Button Text="Volver"
                    BackgroundColor="#43a047"
                    TextColor="White"
                    FontFamily="Roboto-Regular"
                    FontSize="20"
                    CornerRadius="10"
                    HeightRequest="40"
                    HorizontalOptions="Start"
                    Margin="0,0,0,10"/>
            <!-- Logo -->
            <Frame Padding="0" HasShadow="False" CornerRadius="50" HeightRequest="100" WidthRequest="100" BackgroundColor="Transparent" HorizontalOptions="Center">
                <Image Source="https://www.figma.com/api/mcp/asset/835afbaf-5f9f-40ba-a645-a69ea42f4d72" Aspect="AspectFill" HeightRequest="100" WidthRequest="100"/>
            </Frame>
            <!-- Título -->
            <Label Text="AutoGestión CIES"
                   FontFamily="Roboto-Bold"
                   FontSize="36"
                   FontAttributes="Bold"
                   TextColor="#43A047"
                   HorizontalOptions="Center"/>
            <!-- Subtítulo -->
            <Label Text="Código de verificación"
                   FontFamily="Roboto-Bold"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="#424242"
                   HorizontalOptions="Center"/>
            <Label Text="Ingresa el código de recuperación que se te envió al correo electrónico ejemplo@soy.sena.edu.co"
                   FontFamily="Roboto-Regular"
                   FontSize="20"
                   TextColor="#757575"
                   HorizontalOptions="Center"/>
            <!-- Input código -->
            <Frame BorderColor="#e0e0e0" CornerRadius="8" Padding="0" HasShadow="False">
                <Grid Padding="17,0" HeightRequest="57" VerticalOptions="Center">
                    <Entry x:Name="CodeEntry" Placeholder="Código de recuperación" FontSize="16" TextColor="#90A4AE" FontFamily="Roboto-Regular"/>
                </Grid>
            </Frame>
            <!-- Botón Verificar Código -->
            <Button Text="Verificar Código"
                    BackgroundColor="#388e3c"
                    TextColor="White"
                    FontFamily="Roboto-SemiBold"
                    FontSize="25"
                    CornerRadius="8"
                    HeightRequest="50"
                    Margin="0,10,0,0"
                    Clicked="OnVerifyCodeClicked"/>
            <!-- Soporte, Términos, Privacidad -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="20" Margin="0,20,0,0">
                <Label Text="Soporte" FontSize="12" TextColor="#9E9E9E" FontFamily="Roboto-Regular"/>
                <Label Text="Términos de Uso" FontSize="12" TextColor="#9E9E9E" FontFamily="Roboto-Regular"/>
                <Label Text="Política de Privacidad" FontSize="12" TextColor="#9E9E9E" FontFamily="Roboto-Regular"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
