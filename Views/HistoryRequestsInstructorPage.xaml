                                    <Label Text="Todos los programas" FontSize="14" TextColor="Black" VerticalOptions="Center"/>
                                    <!-- Icono flecha (placeholder) -->
                                    <Frame BackgroundColor="#E0E0E0" CornerRadius="6" HeightRequest="12" WidthRequest="12" Padding="0" VerticalOptions="Center"/>
