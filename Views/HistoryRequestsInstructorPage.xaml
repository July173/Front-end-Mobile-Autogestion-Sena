                        <!-- Botones de paginación -->
                        <HorizontalStackLayout Spacing="15" HorizontalOptions="End" WidthRequest="950">
                            <Frame BorderColor="#a19b9b" CornerRadius="5" WidthRequest="78" Padding="7,0">
                                <HorizontalStackLayout Spacing="3">
                                    <!-- Icono anterior (placeholder) -->
                                    <Frame BackgroundColor="#E0E0E0" CornerRadius="5" HeightRequest="10" WidthRequest="10" Padding="0" VerticalOptions="Center"/>
