                                    <Label Text="Tarjeta de identidad" FontSize="14" TextColor="Black" WidthRequest="162"/>
                                    <Label Text="1016457896" FontSize="14" TextColor="Black" WidthRequest="162"/>
                                    <Label Text="10/05/2025" FontSize="14" TextColor="Black" WidthRequest="136"/>
                                    <Frame BackgroundColor="#ffa577" CornerRadius="20" HeightRequest="33" WidthRequest="180" Padding="0" VerticalOptions="Center">
                                        <HorizontalStackLayout>
                                            <!-- Icono parcial (placeholder) -->
                                            <Frame BackgroundColor="#E0E0E0" CornerRadius="10" HeightRequest="23" WidthRequest="23" Padding="0" VerticalOptions="Center"/>
                                            <Label Text="Visita Parcial" FontSize="20" TextColor="Black" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </Frame>
                                </HorizontalStackLayout>
                                <!-- Fila ejemplo 3 -->
                                <HorizontalStackLayout Spacing="20" Padding="0,13">
                                    <Label Text="3" FontSize="14" TextColor="Black" WidthRequest="30"/>
                                    <Label Text="Daniela Polania Quintero" FontSize="14" TextColor="Black" WidthRequest="162"/>
                                    <Label Text="Tarjeta de identidad" FontSize="14" TextColor="Black" WidthRequest="162"/>
                                    <Label Text="1016457896" FontSize="14" TextColor="Black" WidthRequest="162"/>
                                    <Label Text="10/05/2025" FontSize="14" TextColor="Black" WidthRequest="136"/>
                                    <Frame BackgroundColor="#fed801" CornerRadius="20" HeightRequest="33" WidthRequest="180" Padding="0" VerticalOptions="Center">
