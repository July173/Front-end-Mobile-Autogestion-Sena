<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:contentViews="clr-namespace:AutogestionSenaMaui.ContentViews"
             x:Class="AutogestionSenaMaui.Views.MainDashboardPage"
             Title="Dashboard">

    <Grid ColumnDefinitions="Auto,*" BackgroundColor="#F8F9FA">
        
        <!-- Menú Lateral Dinámico -->
        <contentViews:DynamicSideMenu Grid.Column="0"/>

        <!-- Contenido Principal -->
        <Grid Grid.Column="1" Padding="20" RowDefinitions="Auto,Auto,*">
            
            <!-- Header con breadcrumb y notificaciones -->
            <Border Grid.Row="0" 
                    BackgroundColor="#DFE3E8"
                    Padding="20,10"
                    Margin="0,0,0,10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                    
                    <!-- Botón de menú hamburguesa (para móvil) -->
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="&#xf479;"
                           FontFamily="BootstrapIcons"
                           FontSize="32"
                           TextColor="#020817"
                           HorizontalOptions="Start"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMenuButtonClicked"/>
                        </Label.GestureRecognizers>
                    </Label>
                    
                    <!-- Breadcrumb -->
                    <HorizontalStackLayout Grid.Row="1" Grid.Column="0"
                                          Spacing="10"
                                          Padding="10,0">
                        <Label Text="dashboard"
                               FontSize="14"
                               TextColor="#263238"
                               Opacity="0.5"
                               VerticalOptions="Center"/>
                        <Label Text=">"
                               FontSize="14"
                               TextColor="#607D8B"
                               VerticalOptions="Center"/>
                        <Label Text="Inicio"
                               FontSize="20"
                               TextColor="#263238"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- Notificaciones -->
                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                            BackgroundColor="Transparent"
                            Padding="10"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNotificationsTapped"/>
                        </Border.GestureRecognizers>
                        
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="&#xf234;"
                                   FontFamily="BootstrapIcons"
                                   FontSize="24"
                                   TextColor="Black"/>
                            <Label Text="Notificaciones"
                                   FontSize="14"
                                   TextColor="Black"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                    
                </Grid>
            </Border>

            <!-- Título de la página actual -->
            <Label Grid.Row="1"
                   x:Name="PageTitle"
                   Text="Administración de Permisos"
                   FontSize="36"
                   FontAttributes="Bold"
                   TextColor="#020817"
                   Margin="0,20,0,10"/>

            <!-- Contenido dinámico -->
            <ScrollView Grid.Row="2">
                <ContentView x:Name="MainContent">
                    <!-- Aquí se cargará el contenido según la navegación -->
                    <VerticalStackLayout Spacing="20" Padding="20">
                        <Label Text="Bienvenido al sistema de Autogestión CIES"
                               FontSize="24"
                               HorizontalOptions="Center"/>
                        <Label Text="Selecciona una opción del menú lateral para comenzar."
                               FontSize="16"
                               TextColor="#64748B"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </ContentView>
            </ScrollView>

        </Grid>

    </Grid>

</ContentPage>
