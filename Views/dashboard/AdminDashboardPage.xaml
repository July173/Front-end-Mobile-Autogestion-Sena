<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:contentViews="clr-namespace:AutogestionSenaMaui.ContentViews"
             x:Class="AutogestionSenaMaui.Views.AdminDashboardPage"
             Title="Dashboard - Administración">

    <contentViews:DashboardLayout x:Name="DashboardLayout">
        <contentViews:DashboardLayout.PageContent>
            <ScrollView>
                <VerticalStackLayout Spacing="12" Padding="20">
                    <Label Text="Administración" FontSize="26" FontAttributes="Bold" HorizontalTextAlignment="Center"/>

                    <!-- DEBUG: Información de Usuario y Menú -->
                    <Frame BackgroundColor="#FFF3CD" BorderColor="#FFC107" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="🔍 DEBUG: Datos del Usuario y Menú" 
                                   FontSize="18" 
                                   FontAttributes="Bold" 
                                   TextColor="#856404"/>
                            
                            <!-- Datos del Usuario -->
                            <Frame BackgroundColor="White" CornerRadius="6" Padding="12" HasShadow="False">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="📋 Datos Guardados en Preferences:" 
                                           FontAttributes="Bold" 
                                           TextColor="#333"/>
                                    <Label x:Name="UserIdLabel" TextColor="#555" FontSize="14"/>
                                    <Label x:Name="UserRoleLabel" TextColor="#555" FontSize="14"/>
                                    <Label x:Name="UserEmailLabel" TextColor="#555" FontSize="14"/>
                                    <Label x:Name="UserNameLabel" TextColor="#555" FontSize="14"/>
                                    <Label x:Name="AuthTokenLabel" TextColor="#555" FontSize="14"/>
                                </VerticalStackLayout>
                            </Frame>

                            <!-- Menú Cargado -->
                            <Frame BackgroundColor="White" CornerRadius="6" Padding="12" HasShadow="False">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="🍔 Menú Dinámico Cargado:" 
                                           FontAttributes="Bold" 
                                           TextColor="#333"/>
                                    <Label x:Name="MenuStatusLabel" TextColor="#555" FontSize="14"/>
                                    <ScrollView MaximumHeightRequest="300">
                                        <VerticalStackLayout x:Name="MenuItemsContainer" Spacing="4"/>
                                    </ScrollView>
                                </VerticalStackLayout>
                            </Frame>

                            <!-- Botón para recargar -->
                            <Button Text="🔄 Recargar Datos de Debug" 
                                    Clicked="OnReloadDebugData"
                                    BackgroundColor="#0D6EFD"
                                    TextColor="White"
                                    CornerRadius="6"
                                    Padding="12"/>
                        </VerticalStackLayout>
                    </Frame>

                    <contentViews:DashboardCards BindingContext="{Binding}"/>

                    <!-- Admin specific summary -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto" ColumnSpacing="12">
                        <Frame BackgroundColor="White" CornerRadius="8" HasShadow="True" Padding="12">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Usuarios" FontAttributes="Bold" FontSize="16" />
                                <Label Text="Total de usuarios registrados" TextColor="#777"/>
                                <Label Text="{Binding TotalUsers}" FontAttributes="Bold" FontSize="22" TextColor="#2E7D32"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame BackgroundColor="White" CornerRadius="8" HasShadow="True" Padding="12">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Roles" FontAttributes="Bold" FontSize="16" />
                                <Label Text="Tipos de roles disponibles" TextColor="#777"/>
                                <Label Text="{Binding TotalRoles}" FontAttributes="Bold" FontSize="22" TextColor="#16A34A"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame BackgroundColor="White" CornerRadius="8" HasShadow="True" Padding="12" Grid.Row="1">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Módulos" FontAttributes="Bold" FontSize="16" />
                                <Label Text="Módulos registrados" TextColor="#777"/>
                                <Label Text="{Binding TotalModules}" FontAttributes="Bold" FontSize="22" TextColor="#7C3AED"/>
                            </VerticalStackLayout>
                        </Frame>

                        <Frame BackgroundColor="White" CornerRadius="8" HasShadow="True" Padding="12" Grid.Row="1">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Formularios" FontAttributes="Bold" FontSize="16" />
                                <Label Text="Formularios disponibles" TextColor="#777"/>
                                <Label Text="{Binding TotalForms}" FontAttributes="Bold" FontSize="22" TextColor="#0EA5A6"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Charts placeholder -->
                        <Frame Grid.ColumnSpan="2" BackgroundColor="White" CornerRadius="8" HasShadow="True" Padding="12">
                            <contentViews:DashboardCharts BindingContext="{Binding}" />
                        </Frame>
                    </Grid>

                </VerticalStackLayout>
            </ScrollView>
        </contentViews:DashboardLayout.PageContent>
    </contentViews:DashboardLayout>
</ContentPage>
