<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:contentViews="clr-namespace:AutogestionSenaMaui.ContentViews"
  x:Class="AutogestionSenaMaui.Views.ApprenticeDashboardPage"
             Title="Dashboard - Aprendiz">

 <VerticalStackLayout>
        <contentViews:DashboardLayout x:Name="DashboardLayout">
            <contentViews:DashboardLayout.PageContent>
           <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="16,20">
            <!-- Saludo principal -->
      <Frame BackgroundColor="White" 
          CornerRadius="10" 
       Padding="0" 
        HorizontalOptions="FillAndExpand"
HasShadow="True">
           <VerticalStackLayout>
      <BoxView HeightRequest="20" 
    BackgroundColor="#2E7D32" 
  CornerRadius="10,10,0,0"/>
       <HorizontalStackLayout Spacing="15" Padding="20,15">
       <Frame BackgroundColor="#CCCCCC" 
      CornerRadius="35" 
        HeightRequest="60" 
         WidthRequest="60" 
                  Padding="5" 
   VerticalOptions="Center">
             <!-- Espacio para icono de usuario -->
      </Frame>
          <!-- Reemplazo de VerticalStackLayout con opciones obsoletas por Grid -->
          <Grid VerticalOptions="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Label Grid.Row="0" Text="¡Bienvenido!" 
                                           FontSize="24" 
                                           FontAttributes="Bold" 
                                           TextColor="Black"/>
                                    <Label Grid.Row="1" Text="Sneide Contreras Velázquez" 
                                           FontSize="18" 
                                           TextColor="Black"
                                           FontAttributes="Bold"/>
                                    <Label Grid.Row="2" Text="Gestiona desde aquí tus procesos de formación" 
                                           FontSize="14" 
                                           TextColor="#666666"/>
                                </Grid>
             </HorizontalStackLayout>
            </VerticalStackLayout>
            </Frame>

     <!-- Estado de solicitud -->
               <Frame BackgroundColor="White" 
               CornerRadius="10" 
         Padding="0" 
    HasShadow="True"
           HorizontalOptions="FillAndExpand">
        <VerticalStackLayout>
           <BoxView HeightRequest="60" 
         BackgroundColor="#2E7D32" 
 CornerRadius="10,10,0,0" 
                VerticalOptions="Start"/>
        <VerticalStackLayout Spacing="15" Padding="20">
      <Frame BackgroundColor="#C4C4C4" 
     CornerRadius="50" 
 HeightRequest="80" 
     WidthRequest="80" 
  Padding="8" 
  HorizontalOptions="Center">
          <!-- Espacio para icono info -->
             </Frame>
          <Label Text="Sin solicitudes para tu etapa productiva" 
            FontSize="18" 
            FontAttributes="Bold"
             TextColor="#333333" 
         HorizontalTextAlignment="Center"/>
                <Label Text="Aún no has solicitado ningún proceso para tu etapa productiva. Por favor registra una solicitud" 
        FontSize="14" 
       TextColor="#666666" 
           HorizontalTextAlignment="Center"/>
       <Button Text="Hacer una solicitud" 
                BackgroundColor="#2E7D32" 
         TextColor="White" 
                CornerRadius="10" 
  FontSize="16" 
      HeightRequest="45"
        HorizontalOptions="FillAndExpand"
         Margin="0,10,0,0"/>
         </VerticalStackLayout>
         </VerticalStackLayout>
     </Frame>

         <!-- Instructor asignado -->
      <Frame BackgroundColor="White" 
               BorderColor="#a5d9a7" 
     CornerRadius="10" 
              Padding="0" 
             HasShadow="True"
        HorizontalOptions="FillAndExpand">
      <VerticalStackLayout>
            <BoxView HeightRequest="60" 
   BackgroundColor="#2E7D32" 
                  CornerRadius="10,10,0,0"/>
      <VerticalStackLayout Spacing="15" Padding="20">
 <Frame BackgroundColor="#C7C7C7" 
          CornerRadius="50" 
               HeightRequest="80" 
        WidthRequest="80" 
    Padding="8" 
          HorizontalOptions="Center">
                 <!-- Espacio para iniciales del instructor -->
   </Frame>
     <Label Text="Instructor No Asignado" 
        FontSize="18" 
         FontAttributes="Bold"
    TextColor="#333333" 
       HorizontalTextAlignment="Center"/>
   <Frame BackgroundColor="#E0E0E0" 
      CornerRadius="20" 
            Padding="12,8" 
        HorizontalOptions="Center">
     <Label Text="Pendiente de Asignar" 
      FontSize="12" 
            TextColor="#666666" 
          HorizontalTextAlignment="Center"/>
          </Frame>
            </VerticalStackLayout>
       </VerticalStackLayout>
  </Frame>

       <!-- Detalle de solicitud -->
         <Frame BackgroundColor="White" 
 CornerRadius="10" 
  Padding="0" 
    HasShadow="True"
     HorizontalOptions="FillAndExpand">
    <VerticalStackLayout>
   <BoxView HeightRequest="60" 
          BackgroundColor="#2E7D32" 
   CornerRadius="10,10,0,0"/>
             <VerticalStackLayout Spacing="15" Padding="20">
           <Frame BackgroundColor="#F5F5F5" 
          CornerRadius="50" 
          HeightRequest="60" 
           WidthRequest="60" 
      Padding="8" 
         HorizontalOptions="Center">
         <!-- Espacio para icono documento -->
  </Frame>
      <Label Text="Sin Solicitud Activa" 
       FontSize="18" 
          FontAttributes="Bold"
            TextColor="#333333" 
        HorizontalTextAlignment="Center"/>
    <Label Text="Aparecerán los detalles de la solicitud una vez sea aprobada" 
    FontSize="14" 
        TextColor="#666666" 
             HorizontalTextAlignment="Center"/>
           
  <!-- Información adicional -->
       <VerticalStackLayout Spacing="10" Margin="0,15,0,0">
           <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
      <Frame BackgroundColor="#E8F5E8" 
              CornerRadius="15" 
              HeightRequest="30" 
  WidthRequest="30" 
          Padding="0">
        <!-- Icono info -->
          </Frame>
     <Label Text="Estado: Pendiente" 
             FontSize="14" 
    TextColor="#666666"
            VerticalOptions="Center"/>
   </HorizontalStackLayout>
         
        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
   <Frame BackgroundColor="#E8F5E8" 
       CornerRadius="15" 
     HeightRequest="30" 
       WidthRequest="30" 
     Padding="0">
   <!-- Icono calendario -->
               </Frame>
      <Label Text="Próximo paso: Realizar solicitud" 
    FontSize="14" 
                 TextColor="#666666"
    VerticalOptions="Center"/>
          </HorizontalStackLayout>
      </VerticalStackLayout>
    </VerticalStackLayout>
            </VerticalStackLayout>
 </Frame>

  <!-- Acciones rápidas -->
    <Frame BackgroundColor="White" 
                  CornerRadius="10" 
               Padding="20" 
     HasShadow="True"
             HorizontalOptions="FillAndExpand">
        <VerticalStackLayout Spacing="15">
  <Label Text="Acciones Rápidas" 
     FontSize="18" 
                FontAttributes="Bold"
             TextColor="#333333"/>
          
         <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
       <Button Grid.Column="0"
         Text="Ver Perfil" 
BackgroundColor="White"
          TextColor="#2E7D32"
          BorderColor="#2E7D32"
             BorderWidth="1"
           CornerRadius="10" 
       FontSize="14" 
    HeightRequest="40"/>

              <Button Grid.Column="1"
          Text="Contactar Soporte" 
      BackgroundColor="White"
            TextColor="#2E7D32"
  BorderColor="#2E7D32"
             BorderWidth="1"
        CornerRadius="10" 
       FontSize="14" 
       HeightRequest="40"/>
         </Grid>
                 </VerticalStackLayout>
        </Frame>
          </VerticalStackLayout>
                </ScrollView>
  </contentViews:DashboardLayout.PageContent>
        </contentViews:DashboardLayout>
    </VerticalStackLayout>

</ContentPage>
