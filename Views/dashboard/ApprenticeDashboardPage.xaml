<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:contentViews="clr-namespace:AutogestionSenaMaui.ContentViews"
             x:Class="AutogestionSenaMaui.Views.ApprenticeDashboardPage"
             Title="Dashboard - Aprendiz">

    <contentViews:DashboardLayout x:Name="DashboardLayout">
        <contentViews:DashboardLayout.PageContent>
            <ScrollView>
                <VerticalStackLayout Spacing="12" Padding="20">
                    <Label Text="¡Bienvenido!"
                           FontSize="26"
                           FontFamily="Roboto-Bold"
                           TextColor="#2E7D32"
                           HorizontalTextAlignment="Center"/>

                    <!-- Banner -->
                    <Frame BackgroundColor="#2E7D32" CornerRadius="12" Padding="16">
                        <VerticalStackLayout>
                            <Label Text="Gestione desde aquí sus procesos de formación" TextColor="White" FontSize="16"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Grid: left (estado), right (instructor & detalles) -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto" ColumnSpacing="12">
                        <!-- Dashboard Cards component -->
                        <contentViews:DashboardCards Grid.ColumnSpan="2" BindingContext="{Binding}"/>
                        <!-- Estado de tu solicitud -->
                        <Frame Grid.Column="0" BackgroundColor="White" CornerRadius="8" HasShadow="True" Padding="12">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Estado de tu solicitud" FontAttributes="Bold" FontSize="16"/>
                                <StackLayout IsVisible="{Binding HasRequest}" Spacing="6">
                                    <Label Text="Solicitud registrada" FontAttributes="Bold"/>
                                    <Label Text="En revisión / ASIGNADO" TextColor="#b0b0b0"/>
                                </StackLayout>
                                <StackLayout IsVisible="{Binding HasRequest, Converter={StaticResource InvertBoolConverter}}" HorizontalOptions="Center">
                                    <Label Text="Sin solicitudes para tu etapa productiva" FontAttributes="Bold"/>
                                    <Button Text="Hacer una solicitud" BackgroundColor="#2E7D32" TextColor="White"/>
                                </StackLayout>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Right column: instructor e info -->
                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                            <Frame BackgroundColor="White" CornerRadius="8" HasShadow="True" Padding="12">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Label Text="Tu Instructor asignado" FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center"/>
                                    <Label Text="{Binding InstructorFullName}" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                                    <Label Text="{Binding Dashboard.Instructor.KnowledgeArea}" HorizontalTextAlignment="Center"/>
                                    <Button Text="Enviar Email" BackgroundColor="#2E7D32" TextColor="White" IsVisible="{Binding Dashboard.Instructor.Email, Converter={StaticResource NotNullToBoolConverter}}"/>
                                </VerticalStackLayout>
                            </Frame>
                            <contentViews:DashboardCharts Grid.Column="1" />

                            <Frame BackgroundColor="White" CornerRadius="8" HasShadow="True" Padding="12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Detalle de tu Solicitud" FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center"/>
                                    <Label Text="Empresa: {Binding Dashboard.Request.EnterpriseName}"/>
                                    <Label Text="Jefe: {Binding Dashboard.Request.BossName}"/>
                                    <Label Text="Fecha Inicio: {Binding Dashboard.Request.StartDate}"/>
                                    <Label Text="Fecha Enviado: {Binding Dashboard.Request.RequestDate}"/>
                                </VerticalStackLayout>
                            </Frame>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </contentViews:DashboardLayout.PageContent>
    </contentViews:DashboardLayout>

</ContentPage>
