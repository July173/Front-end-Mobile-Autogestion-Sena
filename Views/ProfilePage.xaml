<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutogestionSenaMaui.Views.ProfilePage"
             Title="Perfil" BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16" VerticalOptions="Start">
            <Frame CornerRadius="64" HeightRequest="120" WidthRequest="120" BackgroundColor="#2e7d32" HorizontalOptions="Center">
                <Label Text="{Binding UserInitials}" TextColor="White" FontSize="36" VerticalOptions="Center" HorizontalOptions="Center" />
            </Frame>

            <Label Text="{Binding UserName}" FontAttributes="Bold" HorizontalOptions="Center" FontSize="18"/>
            <Label Text="{Binding UserEmail}" HorizontalOptions="Center" FontSize="14"/>
            <Label Text="{Binding RoleName}" HorizontalOptions="Center" FontSize="14"/>

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,10,0,0">
                <Button Text="Ver perfil" Command="{Binding ViewProfileCommand}" />
                <Button Text="Cambiar rol" Command="{Binding ChangeRoleCommand}" />
            </HorizontalStackLayout>

            <Button Text="Cerrar sesión" BackgroundColor="#D32F2F" TextColor="White" Command="{Binding LogoutCommand}" />

            <Label Text="Acciones rápidas" FontAttributes="Bold" Margin="0,16,0,0"/>

            <VerticalStackLayout Spacing="8">
                <Button Text="Editar información" Command="{Binding EditProfileCommand}" />
                <Button Text="Cambiar foto" Command="{Binding ChangePhotoCommand}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>