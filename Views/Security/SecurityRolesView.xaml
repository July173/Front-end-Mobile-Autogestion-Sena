<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                      xmlns:helpers="clr-namespace:AutogestionSenaMaui.Helpers"
                      xmlns:models="clr-namespace:AutogestionSenaMaui.ViewModels.Security.Models"
                      xmlns:vm="clr-namespace:AutogestionSenaMaui.ViewModels.Security"
                      x:Class="AutogestionSenaMaui.Views.Security.SecurityRolesView"
                     x:DataType="vm:SecurityRolesViewModel"
                     x:Name="RolesViewRoot">

       <Frame BackgroundColor="White"
                 HasShadow="False"
                 Padding="24"
                 BorderColor="#E4E7EC"
                 CornerRadius="18">
              <VerticalStackLayout Spacing="20">
                     <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                            <Label Text="{Binding PanelTitle}"
                                      FontSize="24"
                                      FontAttributes="Bold"
                                      TextColor="#020817"
                                      VerticalOptions="Center"/>

                            <Border BackgroundColor="#3B933F"
                                          Padding="14,10"
                                          HorizontalOptions="End"
                                          StrokeThickness="0">
                                   <Border.StrokeShape>
                                          <RoundRectangle CornerRadius="10"/>
                                   </Border.StrokeShape>
                                   <Border.GestureRecognizers>
                                          <TapGestureRecognizer Command="{Binding RegisterRoleCommand}"/>
                                   </Border.GestureRecognizers>
                                   <HorizontalStackLayout Spacing="8">
                                          <Label Text="{x:Static helpers:BootstrapIcons.Plus}"
                                                    FontFamily="BootstrapIcons"
                                                    FontSize="16"
                                                    TextColor="White"
                                                    VerticalOptions="Center"/>
                                          <Label Text="Registro Rol"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="White"
                                                    VerticalOptions="Center"/>
                                   </HorizontalStackLayout>
                            </Border>
                     </Grid>

                     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Border Stroke="#7D7E81"
                                          StrokeThickness="1"
                                          Padding="12"
                                          BackgroundColor="White">
                                   <Border.StrokeShape>
                                          <RoundRectangle CornerRadius="10"/>
                                   </Border.StrokeShape>
                                   <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                          <Label Text="{x:Static helpers:BootstrapIcons.Search}"
                                                    FontFamily="BootstrapIcons"
                                                    FontSize="14"
                                                    TextColor="#A19B9B"
                                                    VerticalOptions="Center"/>
                                          <Entry Grid.Column="1"
                                                    Text="{Binding SearchText}"
                                                    Placeholder="{Binding SearchPlaceholder}"
                                                    TextColor="#020817"
                                                    PlaceholderColor="#94A3B8"
                                                    BackgroundColor="Transparent"
                                                    FontSize="14"
                                                    VerticalOptions="Center"/>
                                   </Grid>
                            </Border>

                            <Border Grid.Column="1"
                                          Stroke="#D1D5DB"
                                          StrokeThickness="1"
                                          Padding="12"
                                          BackgroundColor="White">
                                   <Border.StrokeShape>
                                          <RoundRectangle CornerRadius="10"/>
                                   </Border.StrokeShape>
                                   <HorizontalStackLayout Spacing="6">
                                          <Label Text="{Binding SelectedRoleFilter}"
                                                    FontSize="14"
                                                    TextColor="#0F172A"/>
                                          <Label Text="{x:Static helpers:BootstrapIcons.ChevronDown}"
                                                    FontFamily="BootstrapIcons"
                                                    FontSize="14"
                                                    TextColor="#0F172A"/>
                                   </HorizontalStackLayout>
                            </Border>
                     </Grid>

                     <CollectionView ItemsSource="{Binding Roles}"
                                                 SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                   <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="18" HorizontalItemSpacing="18"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.EmptyView>
                                   <Label Text="No hay roles disponibles"
                                             HorizontalTextAlignment="Center"/>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                   <DataTemplate x:DataType="models:RoleCardItem">
                                          <Border Stroke="#D1D1D5"
                                                        StrokeThickness="1"
                                                        Padding="16"
                                                        WidthRequest="300">
                                                 <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="16"/>
                                                 </Border.StrokeShape>
                                                 <VerticalStackLayout Spacing="12">
                                                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                                               <Label Text="{Binding Name}"
                                                                         FontSize="18"
                                                                         FontAttributes="Bold"
                                                                         TextColor="#0F172A"/>
                                                               <Border Grid.Column="1"
                                                                             BackgroundColor="{Binding StatusBackground}"
                                                                             Padding="12,4"
                                                                             StrokeThickness="0"
                                                                             HorizontalOptions="End">
                                                                      <Border.StrokeShape>
                                                                             <RoundRectangle CornerRadius="999"/>
                                                                      </Border.StrokeShape>
                                                                      <Label Text="{Binding StatusLabel}"
                                                                                FontSize="12"
                                                                                FontAttributes="Bold"
                                                                                TextColor="{Binding StatusTextColor}"/>
                                                               </Border>
                                                        </Grid>

                                                        <Label Text="{Binding Description}"
                                                                  FontSize="13"
                                                                  TextColor="#0F172A"/>

                                                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                                               <Label Text="{Binding AssignedUsersText}"
                                                                         FontSize="12"
                                                                         TextColor="#0F172A"/>
                                                               <Border Grid.Column="1"
                                                                             Stroke="#D1D1D5"
                                                                             StrokeThickness="1"
                                                                             Padding="10,4">
                                                                      <Border.StrokeShape>
                                                                             <RoundRectangle CornerRadius="10"/>
                                                                      </Border.StrokeShape>
                                                                      <Border.GestureRecognizers>
                                                                             <TapGestureRecognizer Command="{Binding Source={x:Reference RolesViewRoot}, Path=BindingContext.EditRoleCommand}"
                                                                                                                  CommandParameter="{Binding .}"/>
                                                                      </Border.GestureRecognizers>
                                                                      <Label Text="Editar"
                                                                                FontSize="12"
                                                                                TextColor="#0F172A"/>
                                                               </Border>
                                                        </Grid>

                                                        <Border Stroke="#B91C1C"
                                                                      StrokeThickness="1"
                                                                      BackgroundColor="#FEE2E2"
                                                                      Padding="16,6">
                                                               <Border.StrokeShape>
                                                                      <RoundRectangle CornerRadius="12"/>
                                                               </Border.StrokeShape>
                                                               <Border.GestureRecognizers>
                                                                      <TapGestureRecognizer Command="{Binding Source={x:Reference RolesViewRoot}, Path=BindingContext.DisableRoleCommand}"
                                                                                                           CommandParameter="{Binding .}"/>
                                                               </Border.GestureRecognizers>
                                                               <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                                                                      <Label Text="{x:Static helpers:BootstrapIcons.Person}"
                                                                                FontFamily="BootstrapIcons"
                                                                                FontSize="14"
                                                                                TextColor="#991B1B"/>
                                                                      <Label Text="Inhabilitar"
                                                                                FontSize="12"
                                                                                TextColor="#991B1B"
                                                                                FontAttributes="Bold"/>
                                                               </HorizontalStackLayout>
                                                        </Border>
                                                 </VerticalStackLayout>
                                          </Border>
                                   </DataTemplate>
                            </CollectionView.ItemTemplate>
                     </CollectionView>
              </VerticalStackLayout>
       </Frame>
</ContentView>
