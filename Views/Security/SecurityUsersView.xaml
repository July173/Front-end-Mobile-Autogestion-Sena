<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                      xmlns:helpers="clr-namespace:AutogestionSenaMaui.Helpers"
                      xmlns:models="clr-namespace:AutogestionSenaMaui.ViewModels.Security.Models"
                      xmlns:vm="clr-namespace:AutogestionSenaMaui.ViewModels.Security"
                      x:Class="AutogestionSenaMaui.Views.Security.SecurityUsersView"
                      x:DataType="vm:SecurityUsersViewModel">

       <Frame BackgroundColor="White"
                 HasShadow="False"
                 Padding="24"
                 BorderColor="#E4E7EC"
                 CornerRadius="18">
              <VerticalStackLayout Spacing="20">
                     <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Grid.Column="0"
                                      Grid.Row="0"
                                      Text="{Binding PanelTitle}"
                                      FontSize="24"
                                      FontAttributes="Bold"
                                      TextColor="#020817"
                                      VerticalOptions="Center"/>

                            <Border Grid.Column="1"
                                          Grid.Row="0"
                                          BackgroundColor="#3B933F"
                                          Padding="14,10"
                                          StrokeThickness="0"
                                          HorizontalOptions="End">
                                   <Border.StrokeShape>
                                          <RoundRectangle CornerRadius="10"/>
                                   </Border.StrokeShape>
                                   <Border.GestureRecognizers>
                                          <TapGestureRecognizer Command="{Binding RegisterUserCommand}"/>
                                   </Border.GestureRecognizers>
                                   <HorizontalStackLayout Spacing="8">
                                          <Label Text="{x:Static helpers:BootstrapIcons.Plus}"
                                                    FontFamily="BootstrapIcons"
                                                    FontSize="16"
                                                    TextColor="White"
                                                    VerticalOptions="Center"/>
                                          <Label Text="Registro usuario"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="White"
                                                    VerticalOptions="Center"/>
                                   </HorizontalStackLayout>
                            </Border>
                     </Grid>

                     <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <Border Stroke="#7D7E81"
                                          StrokeThickness="1"
                                          Padding="12"
                                          BackgroundColor="White">
                                   <Border.StrokeShape>
                                          <RoundRectangle CornerRadius="10"/>
                                   </Border.StrokeShape>
                                   <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                          <Label Text="{x:Static helpers:BootstrapIcons.Search}"
                                                    FontFamily="BootstrapIcons"
                                                    FontSize="14"
                                                    TextColor="#A19B9B"
                                                    VerticalOptions="Center"/>
                                          <Entry Grid.Column="1"
                                                    Text="{Binding SearchText}"
                                                    Placeholder="{Binding SearchPlaceholder}"
                                                    TextColor="#020817"
                                                    PlaceholderColor="#94A3B8"
                                                    BackgroundColor="Transparent"
                                                    FontSize="14"
                                                    VerticalOptions="Center"/>
                                   </Grid>
                            </Border>

                            <Border Grid.Column="1"
                                          Stroke="#D1D5DB"
                                          StrokeThickness="1"
                                          Padding="12"
                                          BackgroundColor="White">
                                   <Border.StrokeShape>
                                          <RoundRectangle CornerRadius="10"/>
                                   </Border.StrokeShape>
                                   <HorizontalStackLayout Spacing="6">
                                          <Label Text="{Binding SelectedUserFilter}"
                                                    FontSize="14"
                                                    TextColor="#0F172A"/>
                                          <Label Text="{x:Static helpers:BootstrapIcons.ChevronDown}"
                                                    FontFamily="BootstrapIcons"
                                                    FontSize="14"
                                                    TextColor="#0F172A"/>
                                   </HorizontalStackLayout>
                            </Border>

                            <Border Grid.Column="2"
                                          Stroke="#D1D5DB"
                                          StrokeThickness="1"
                                          Padding="12"
                                          BackgroundColor="White">
                                   <Border.StrokeShape>
                                          <RoundRectangle CornerRadius="10"/>
                                   </Border.StrokeShape>
                                   <HorizontalStackLayout Spacing="6">
                                          <Label Text="{Binding SelectedStateFilter}"
                                                    FontSize="14"
                                                    TextColor="#0F172A"/>
                                          <Label Text="{x:Static helpers:BootstrapIcons.ChevronDown}"
                                                    FontFamily="BootstrapIcons"
                                                    FontSize="14"
                                                    TextColor="#0F172A"/>
                                   </HorizontalStackLayout>
                            </Border>
                     </Grid>

                     <CollectionView ItemsSource="{Binding StatusCards}"
                                                 SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                   <LinearItemsLayout Orientation="Vertical"
                                                                 ItemSpacing="12"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                   <DataTemplate x:DataType="models:UserStatusItem">
                                          <Border BackgroundColor="{Binding BackgroundColor}"
                                                        Padding="20"
                                                        StrokeThickness="0">
                                                 <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="12"/>
                                                 </Border.StrokeShape>
                                                 <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                                        <HorizontalStackLayout Spacing="16">
                                                               <Label Text="{Binding Title}"
                                                                         FontSize="20"
                                                                         FontAttributes="Bold"
                                                                         TextColor="{Binding AccentColor}"/>
                                                               <Border BackgroundColor="{Binding BadgeBackgroundColor}"
                                                                             Padding="10,2"
                                                                             StrokeThickness="0"
                                                                             VerticalOptions="Center">
                                                                      <Border.StrokeShape>
                                                                             <RoundRectangle CornerRadius="999"/>
                                                                      </Border.StrokeShape>
                                                                      <Label Text="{Binding Count}"
                                                                                FontSize="12"
                                                                                FontAttributes="Bold"
                                                                                TextColor="{Binding BadgeTextColor}"/>
                                                               </Border>
                                                        </HorizontalStackLayout>
                                                        <Label Grid.Column="1"
                                                                  Text="{x:Static helpers:BootstrapIcons.ChevronDown}"
                                                                  FontFamily="BootstrapIcons"
                                                                  FontSize="20"
                                                                  TextColor="#0F172A"
                                                                  HorizontalOptions="End"
                                                                  VerticalOptions="Center"/>
                                                 </Grid>
                                          </Border>
                                   </DataTemplate>
                            </CollectionView.ItemTemplate>
                     </CollectionView>
              </VerticalStackLayout>
       </Frame>
</ContentView>
