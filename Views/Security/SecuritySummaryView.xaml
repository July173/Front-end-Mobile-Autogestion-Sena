<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sections="clr-namespace:AutogestionSenaMaui.Views.Security.SeccionesSecurity"
             xmlns:vm="clr-namespace:AutogestionSenaMaui.ViewModels.Security"
             x:Class="AutogestionSenaMaui.Views.Security.SecuritySummaryView"
             x:DataType="vm:SecuritySummaryViewModel">

    <VerticalStackLayout Spacing="24">
        <sections:PermissionMatrixView ItemsSource="{Binding PermissionMatrix}"/>

        <Frame BackgroundColor="White"
               BorderColor="#E4E7EC"
               CornerRadius="12"
               Padding="24"
               HasShadow="False">
            <VerticalStackLayout Spacing="4">
                <Label Text="Distribución por Roles"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="#020817"/>
                <Label Text="Usuarios asignados por rol"
                       FontSize="16"
                       TextColor="#475467"/>
                <sections:RoleDistributionListView ItemsSource="{Binding RoleDistribution}"/>
            </VerticalStackLayout>
        </Frame>
    </VerticalStackLayout>

</ContentView>
