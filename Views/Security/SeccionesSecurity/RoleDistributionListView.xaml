<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutogestionSenaMaui.Views.Security.SeccionesSecurity.RoleDistributionListView"
             x:Name="Root">
    <VerticalStackLayout Spacing="12"
                         BindableLayout.ItemsSource="{Binding ItemsSource, Source={x:Reference Root}}">
        <BindableLayout.ItemTemplate>
            <DataTemplate>
                <Frame BackgroundColor="#F0FDF4"
                       BorderColor="#16A34A"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="False">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Role}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#047857"/>
                            <Label Text="{Binding Description}"
                                   FontSize="14"
                                   TextColor="#475467"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="-2"
                                             HorizontalOptions="End"
                                             VerticalOptions="Center">
                            <Label Text="{Binding Count}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#047857"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="{Binding CountLabel}"
                                   FontSize="12"
                                   TextColor="#047857"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>
</ContentView>