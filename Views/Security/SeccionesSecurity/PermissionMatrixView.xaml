<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutogestionSenaMaui.Views.Security.SeccionesSecurity.PermissionMatrixView"
             x:Name="Root">
    <Frame BackgroundColor="White"
           BorderColor="#E4E7EC"
           CornerRadius="12"
           Padding="24"
           HasShadow="False">
        <Grid RowDefinitions="Auto, *" RowSpacing="20">
            <Label Text="Resumen del modelo de seguridad"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#020817"/>

            <ScrollView Grid.Row="1"
                       Orientation="Both">
                <Grid RowDefinitions="Auto, Auto"
                      ColumnSpacing="0"
                      RowSpacing="0">
                    <Grid ColumnDefinitions="2.2*,3.2*,1*,1*,1*,1.4*"
                          BackgroundColor="#F4F6FB"
                          Padding="12,8"
                          ColumnSpacing="16">
                        <Label Text="Rol"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#020817"/>
                        <Label Grid.Column="1"
                               Text="Formulario"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#020817"/>
                        <Label Grid.Column="2"
                               Text="Visualizar"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#020817"
                               HorizontalTextAlignment="Center"/>
                        <Label Grid.Column="3"
                               Text="Editar"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#020817"
                               HorizontalTextAlignment="Center"/>
                        <Label Grid.Column="4"
                               Text="Eliminar"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#020817"
                               HorizontalTextAlignment="Center"/>
                        <Label Grid.Column="5"
                               Text="Inhabilitar / Habilitar"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#020817"
                               HorizontalTextAlignment="Center"/>
                    </Grid>

                    <VerticalStackLayout Grid.Row="1"
                                          Spacing="0"
                                          BindableLayout.ItemsSource="{Binding ItemsSource, Source={x:Reference Root}}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="2.2*,3.2*,1*,1*,1*,1.4*"
                                      Padding="12,10"
                                      ColumnSpacing="16"
                                      BackgroundColor="White">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="1"/>
                                    </Grid.RowDefinitions>

                                    <Label Text="{Binding Role}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#020817"/>

                                    <Label Grid.Column="1"
                                           Text="{Binding FormName}"
                                           FontSize="16"
                                           TextColor="#020817"/>

                                    <Label Grid.Column="2"
                                           Text="✓"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           TextColor="#079455">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding CanView}" Value="False">
                                                <Setter Property="Text" Value="✕" />
                                                <Setter Property="TextColor" Value="#D92D20" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <Label Grid.Column="3"
                                           Text="✓"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           TextColor="#079455">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding CanEdit}" Value="False">
                                                <Setter Property="Text" Value="✕" />
                                                <Setter Property="TextColor" Value="#D92D20" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <Label Grid.Column="4"
                                           Text="✓"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           TextColor="#079455">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding CanDelete}" Value="False">
                                                <Setter Property="Text" Value="✕" />
                                                <Setter Property="TextColor" Value="#D92D20" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <Label Grid.Column="5"
                                           Text="✓"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           TextColor="#079455">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding CanToggle}" Value="False">
                                                <Setter Property="Text" Value="✕" />
                                                <Setter Property="TextColor" Value="#D92D20" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <BoxView Grid.Row="1"
                                             Grid.ColumnSpan="6"
                                             Color="#E4E7EC"
                                             HeightRequest="1"
                                             VerticalOptions="End"
                                             Margin="0,12,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Grid>
            </ScrollView>
        </Grid>
    </Frame>
</ContentView>