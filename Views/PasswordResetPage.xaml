<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AutogestionSena.MAUI.Views.PasswordResetPage"
             BackgroundColor="White">
    <ScrollView>
        <VerticalStackLayout Padding="30,40" Spacing="30" HorizontalOptions="Center" WidthRequest="400">
            <!-- Volver a inicio de sesión -->
            <Button Text="Volver a inicio de sesión"
                    BackgroundColor="#43a047"
                    TextColor="White"
                    FontFamily="Roboto-Regular"
                    FontSize="20"
                    CornerRadius="10"
                    HeightRequest="40"
                    HorizontalOptions="Start"
                    Margin="0,0,0,10"/>
            <!-- Logo -->
            <Frame Padding="0" HasShadow="False" CornerRadius="40" HeightRequest="80" WidthRequest="80" BackgroundColor="Transparent" HorizontalOptions="Center">
                <Image Source="https://www.figma.com/api/mcp/asset/3b20a39b-4857-475c-bf34-3f9d16456d70" Aspect="AspectFill" HeightRequest="80" WidthRequest="80"/>
            </Frame>
            <!-- Título -->
            <Label Text="AutoGestión CIES"
                   FontFamily="Roboto-Bold"
                   FontSize="29"
                   FontAttributes="Bold"
                   TextColor="#43A047"
                   HorizontalOptions="Center"/>
            <!-- Subtítulo -->
            <Label Text="Restablecer contraseña"
                   FontFamily="Roboto-Bold"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="#424242"
                   HorizontalOptions="Center"/>
            <Label Text="Ingresa tu correo institucional para restablecer tu contraseña."
                   FontFamily="Roboto-Regular"
                   FontSize="20"
                   TextColor="#757575"
                   HorizontalOptions="Center"/>
            <!-- Input correo -->
            <Frame BorderColor="#e5e7eb" CornerRadius="6" Padding="0" HasShadow="False">
                <Grid Padding="10,0" HeightRequest="50" VerticalOptions="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="https://www.figma.com/api/mcp/asset/3b20a39b-4857-475c-bf34-3f9d16456d70" HeightRequest="25" WidthRequest="25" VerticalOptions="Center"/>
                    <Entry Grid.Column="1" Placeholder="Correo institucional : ejemplo@soy.sena.edu.co" FontSize="13" TextColor="#757575" FontFamily="Roboto-Regular"/>
                </Grid>
            </Frame>
            <!-- Botón Restablecer -->
            <Button Text="Restablecer contraseña"
                    BackgroundColor="#388e3c"
                    TextColor="White"
                    FontFamily="Roboto-SemiBold"
                    FontSize="30"
                    CornerRadius="8"
                    HeightRequest="50"
                    Margin="0,10,0,0"/>
            <!-- Soporte, Términos, Privacidad -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="20" Margin="0,20,0,0">
                <Label Text="Soporte" FontSize="12" TextColor="#9E9E9E" FontFamily="Roboto-Regular"/>
                <Label Text="Términos de Uso" FontSize="12" TextColor="#9E9E9E" FontFamily="Roboto-Regular"/>
                <Label Text="Política de Privacidad" FontSize="12" TextColor="#9E9E9E" FontFamily="Roboto-Regular"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
